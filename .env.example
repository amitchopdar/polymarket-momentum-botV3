# ==============================================================================
# POLYMARKET BOT V2 ENVIRONMENT VARIABLES
# Copy this file to .env and fill in your private credentials.
# ==============================================================================

# 1. Execution Mode ('DRY_RUN' or 'LIVE')
EXECUTION_MODE="DRY_RUN"

# 2. Telegram Notifications & Remote Command Controls
TELEGRAM_BOT_TOKEN="your_bot_token_from_botfather"
TELEGRAM_CHAT_ID="your_telegram_chat_id"
TELEGRAM_AUTHORIZED_USER_IDS="123456789,987654321"

# 3. Polymarket Live Wallet & API Credentials (Required ONLY for LIVE mode)
POLYMARKET_API_KEY=""
POLYMARKET_SECRET=""
POLYMARKET_PASSPHRASE=""
POLYMARKET_PRIVATE_KEY=""

# 4. Dynamic Strategy Parameter Overrides (Optional)
V2_MOMENTUM_THRESHOLD_CENTS=0.15
V2_ENTRY_SLIPPAGE_BUFFER=0.04
V2_TAKE_PROFIT_PCT=0.05
V2_STOP_LOSS_PCT=0.10
V2_HIGH_ODDS_CUTOFF=0.93
V2_HIGH_ODDS_TP_TARGET=0.995
MAX_POSITION_SIZE_USD=2.0
