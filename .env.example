# ==============================================================================
# POLYMARKET BOT V3 ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env on your server and fill in your private credentials.
# ==============================================================================

# 1. Execution Mode ('DRY_RUN' or 'LIVE')
EXECUTION_MODE="LIVE"

# 2. Polymarket Live Wallet Credentials (Required for LIVE mode)
POLYMARKET_PRIVATE_KEY="0xYourMetaMaskPrivateKey"
POLYMARKET_FUNDER="0xYourPolymarketDepositWalletAddress"

# 3. Telegram Notifications & Remote Command Router
TELEGRAM_BOT_TOKEN="your_telegram_bot_token"
TELEGRAM_AUTHORIZED_USER_IDS="123456789,987654321"

# 4. Strategy Parameter Overrides (Optional - Defaults in config.py)
V2_MOMENTUM_THRESHOLD_CENTS=0.15
V2_MIN_ENTRY_ODDS_FLOOR=0.65
V2_MAX_ENTRY_ODDS_CEILING=0.92
V2_TAKE_PROFIT_CENTS=0.20
V2_TRAILING_SL_DISTANCE_CENTS=0.10
V3_MAKER_OFFSET_CENTS=0.02
V3_MAKER_ORDER_TIMEOUT_SEC=5.0
MAX_POSITION_SIZE_USD=5.0
